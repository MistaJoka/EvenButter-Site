---
import { Image } from "astro:assets";
import marcel from "../assets/marcel.png";
import { flavors } from "../data/flavors.js";
import Nav from "./Nav.astro";

// Stickers scattered around Marcel. Positions are % of the art box; tilt in deg.
const orbit = [
  { slug: "the-ccc", top: 2, left: 4, size: 30, tilt: -10 },
  { slug: "raspberry-smores", top: 0, left: 66, size: 27, tilt: 8 },
  { slug: "fudge-brownie", top: 66, left: 0, size: 28, tilt: 6 },
  { slug: "jam-and-toast", top: 70, left: 70, size: 26, tilt: -7 },
];
const stickers = orbit.map((o) => ({ ...o, ...flavors.find((f) => f.slug === o.slug) }));
---
<header class="hero">
  <Nav />

  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__kicker">Even Butter Bake Shop</p>
      <h1 class="hero__title">Homemade cookies, baked in North Miami.</h1>
      <p class="hero__sub">
        Small batches, premium ingredients, plenty of chocolate, and a lot of butter.
        Orders open soon. Join the list and you'll hear first.
      </p>
      <div class="hero__actions">
        <a class="btn" href="#waitlist">Notify me when we open</a>
        <a class="hero__link" href="#flavors">See the flavors</a>
      </div>
    </div>

    <div class="hero__art">
      <div class="hero__disc" aria-hidden="true"></div>
      <Image
        class="hero__marcel"
        src={marcel}
        alt="Marcel the cow driving the Even Butter delivery van"
        width={760}
        widths={[260, 380, 520, 760]}
        sizes="(max-width: 860px) 250px, 370px"
        background="#FFFDF8"
        loading="eager"
        fetchpriority="high"
      />
      {stickers.map((s) => (
        <Image
          class="hero__sticker"
          src={s.sticker}
          alt=""
          width={320}
          widths={[120, 160, 240, 320]}
          background="#FFFDF8"
          sizes="(max-width: 860px) 110px, 160px"
          loading="eager"
          style={`top:${s.top}%;left:${s.left}%;width:${s.size}%;--tilt:${s.tilt}deg`}
        />
      ))}
    </div>
  </div>

  <div class="hero__scallop" aria-hidden="true"></div>
</header>

<style>
  .hero {
    position: relative;
    background: var(--cream);
    padding: 0 1.25rem clamp(4.5rem, 8vw, 7rem);
  }


  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-top: clamp(1.5rem, 5vw, 4rem);
  }

  .hero__kicker {
    font-family: var(--font-hand);
    font-size: 1.7rem;
    color: var(--cocoa-soft);
    margin: 0 0 0.5rem;
  }
  .hero__title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin: 0 0 1.5rem;
    max-width: 12ch;
  }
  .hero__sub {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    color: var(--cocoa-soft);
    max-width: 44ch;
    margin: 0 0 2.25rem;
  }
  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem 1.75rem;
  }
  .hero__link {
    font-family: var(--font-display);
    font-weight: 500;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }

  .hero__art {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    max-width: 560px;
    justify-self: center;
  }
  .hero__disc {
    position: absolute;
    inset: 9%;
    border-radius: 50%;
    background: var(--butter);
    border: 2.5px solid var(--cocoa);
    box-shadow: 10px 10px 0 var(--cocoa);
  }
  .hero__marcel {
    position: absolute;
    inset: 17%;
    width: 66%;
    border-radius: 50%;
    background: var(--white);
  }
  .hero__sticker {
    position: absolute;
    height: auto;
    border-radius: 50%;
    background: var(--white);
    padding: 4%;
    border: 2px solid var(--cocoa);
    transform: rotate(var(--tilt));
    animation: settle 0.7s cubic-bezier(0.3, 1.5, 0.6, 1) backwards;
  }
  .hero__sticker:nth-of-type(3) { animation-delay: 0.1s; }
  .hero__sticker:nth-of-type(4) { animation-delay: 0.2s; }
  .hero__sticker:nth-of-type(5) { animation-delay: 0.3s; }
  @keyframes settle {
    from { opacity: 0; transform: rotate(calc(var(--tilt) * -2)) scale(0.6); }
  }

  .hero__scallop {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 40px;
    background:
      radial-gradient(circle at 20px -8px, transparent 22px, var(--butter-soft) 23px) 0 0 / 40px 40px repeat-x;
  }

  @media (max-width: 860px) {
    .hero__grid { grid-template-columns: 1fr; text-align: center; }
    .hero__title, .hero__sub { margin-left: auto; margin-right: auto; }
    .hero__actions { justify-content: center; }
    .hero__art { max-width: 380px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__sticker { animation: none; }
  }
</style>
