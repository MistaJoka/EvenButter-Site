---
import { Image } from "astro:assets";
// Delivery scene cropped from Rachel's Marcell brand sheet.
import marcellVan from "../assets/marcell-van.png";
import Nav from "./Nav.astro";
---
<header class="hero">
  <Nav />

  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__kicker">Even Butter Bake Shop</p>
      <h1 class="hero__title">Homemade cookies, baked in North Miami.</h1>
      <p class="hero__sub">
        Small batches, premium ingredients, plenty of chocolate, and a lot of butter.
        Orders open soon. Join the list and you'll hear first.
      </p>
      <div class="hero__actions">
        <a class="btn" href="#waitlist">Notify me when we open</a>
        <a class="hero__link" href="#flavors">See the flavors</a>
      </div>
    </div>

    <div class="hero__art">
      <Image
        class="hero__marcel"
        src={marcellVan}
        alt="Marcell the cow waving from the Even Butter delivery van"
        width={580}
        widths={[290, 435, 580]}
        sizes="(max-width: 860px) 90vw, 520px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>

  <div class="hero__scallop" aria-hidden="true"></div>
</header>

<style>
  .hero {
    position: relative;
    background: var(--cream);
    padding: 0 1.25rem clamp(4.5rem, 8vw, 7rem);
  }


  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-top: clamp(1.5rem, 5vw, 4rem);
  }

  .hero__kicker {
    font-family: var(--font-hand);
    font-size: 1.7rem;
    color: var(--cocoa-soft);
    margin: 0 0 0.5rem;
  }
  .hero__title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin: 0 0 1.5rem;
    max-width: 12ch;
  }
  .hero__sub {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    color: var(--cocoa-soft);
    max-width: 44ch;
    margin: 0 0 2.25rem;
  }
  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem 1.75rem;
  }
  .hero__link {
    font-family: var(--font-display);
    font-weight: 500;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }

  .hero__art {
    width: 100%;
    max-width: 540px;
    justify-self: center;
  }
  .hero__marcel {
    display: block;
    width: 100%;
    height: auto;
    background: #FDFCF7;
    border: 2.5px solid var(--cocoa);
    border-radius: 28px;
    box-shadow: 10px 10px 0 var(--butter);
    animation: arrive 0.6s cubic-bezier(0.3, 1.4, 0.6, 1) backwards;
  }
  @keyframes arrive {
    from { opacity: 0; transform: translateX(-24px); }
  }

  .hero__scallop {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 40px;
    background:
      radial-gradient(circle at 20px -8px, transparent 22px, var(--butter-soft) 23px) 0 0 / 40px 40px repeat-x;
  }

  @media (max-width: 860px) {
    .hero__grid { grid-template-columns: 1fr; text-align: center; }
    .hero__title, .hero__sub { margin-left: auto; margin-right: auto; }
    .hero__actions { justify-content: center; }
    .hero__art { max-width: 440px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__marcel { animation: none; }
  }
</style>
