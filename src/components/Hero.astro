---
const tagline = "Small-batch treats, made the right way.";
---
<header class="hero">
  <div class="container hero__inner">
    <p class="eyebrow">welcome to</p>
    <img
      class="hero__logo"
      src="/images/logo.png"
      alt="Even Butter Bake Shop"
      width="520"
      height="318"
      fetchpriority="high"
    />
    <img
      class="hero__marcel floaty"
      src="/images/marcel.png"
      alt="Marcel the cow driving the Even Butter delivery van"
      width="300"
      height="300"
    />
    <p class="hero__tagline">{tagline}</p>
    <p class="hero__sub">Cookies and sweet things, baked with love (and a lot of butter).</p>
    <a class="btn" href="#waitlist">Notify me when we open</a>
    <p class="hero__hint">orders aren't open just yet — but they're coming soon</p>
  </div>

  <div class="hero__scallop" aria-hidden="true"></div>
</header>

<style>
  .hero {
    position: relative;
    background: var(--cream);
    padding: clamp(2.5rem, 7vw, 4.5rem) 1.25rem clamp(4rem, 9vw, 6.5rem);
    overflow: hidden;
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero__logo {
    width: min(520px, 82vw);
    height: auto;
    margin: 0.25rem 0 0.5rem;
  }
  .hero__marcel {
    width: min(300px, 60vw);
    height: auto;
    margin: 0.5rem 0 1rem;
  }
  .hero__tagline {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.3rem, 3.6vw, 1.9rem);
    margin: 0 0 0.35rem;
  }
  .hero__sub {
    max-width: 32ch;
    color: var(--cocoa-soft);
    margin: 0 0 1.6rem;
  }
  .hero__hint {
    font-family: var(--font-hand);
    font-size: 1.4rem;
    color: var(--cocoa-soft);
    margin: 1rem 0 0;
  }
  .hero__scallop {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 40px;
    background:
      radial-gradient(circle at 20px -8px, transparent 22px, var(--butter-soft) 23px) 0 0 / 40px 40px repeat-x;
  }
</style>
