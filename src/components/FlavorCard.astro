---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  sticker: ImageMetadata;
  description: string;
  index?: number;
}
const { name, sticker, description, index = 0 } = Astro.props;
const tilts = [-4, 3, -2, 5, -5, 2, 4, -3];
---
<article class="flavor" style={`--tilt:${tilts[index % tilts.length]}deg`}>
  <Image src={sticker} alt={`Even Butter ${name} sticker`} width={420} />
  <h3 class="flavor__name">{name}</h3>
  <p class="flavor__desc">{description}</p>
</article>

<style>
  .flavor { text-align: center; }
  .flavor img {
    width: min(100%, 210px);
    margin: 0 auto 1.1rem;
    border-radius: 50%;
    background: var(--white);
    padding: 6%;
    border: 2px solid var(--cocoa);
    box-shadow: 5px 5px 0 var(--cocoa);
    transform: rotate(var(--tilt));
    transition: transform 0.2s ease;
  }
  .flavor:hover img { transform: rotate(0deg) scale(1.04); }
  .flavor__name { margin: 0 0 0.35rem; }
  .flavor__desc {
    margin: 0 auto;
    max-width: 26ch;
    font-size: 0.98rem;
    color: var(--cocoa-soft);
    line-height: 1.55;
  }
</style>
