---
import { Image } from "astro:assets";
import marcel from "../assets/marcel.png";
---
<section class="band">
  <div class="container band__inner">
    <Image
      class="band__marcel"
      src={marcel}
      alt="Marcel the cow in the Even Butter delivery van"
      width={480}
      widths={[180, 240, 360, 480]}
      sizes="(max-width: 540px) 45vw, 240px"
      background="#FFFDF8"
    />
    <div class="band__text">
      <h2>Marcel's warming up the van</h2>
      <p>Local pickup and delivery around North Miami are on the way. Marcel can't wait to bring you cookies.</p>
      <span class="pill">Deliveries coming soon</span>
    </div>
  </div>
</section>

<style>
  .band { background: var(--sage); padding: clamp(2.5rem, 6vw, 4rem) 1.25rem; }
  .band__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 4vw, 2.5rem);
    flex-wrap: wrap;
    text-align: center;
  }
  .band__marcel { width: min(240px, 45vw); height: auto; border-radius: 50%; background: var(--white); border: 2.5px solid var(--cocoa); }
  .band__text { max-width: 44ch; text-align: left; }
  .band__text h2 { font-size: clamp(1.7rem, 3.5vw, 2.5rem); }
  .band__text p { color: var(--cocoa-soft); }
  .band .pill { background: var(--white); border: 2px solid var(--cocoa); }
  @media (max-width: 560px) {
    .band__text { text-align: center; }
  }
</style>
