---
import { WAITLIST_ACTION, isWaitlistConfigured } from "../data/waitlist.js";

if (!isWaitlistConfigured) {
  console.warn(
    "\n[waitlist] FORMSPREE_FORM_ID is still the placeholder. The form renders but signups" +
      " will fail. Set it in src/data/waitlist.js."
  );
}

const action = WAITLIST_ACTION;
// Where Formspree sends visitors after a no-JavaScript submit. The page reads
// ?joined=1 on load and shows the same thank-you message the JS path shows.
const next = new URL("/?joined=1#waitlist", Astro.site).href;
---
<section id="waitlist" class="section waitlist">
  <div class="container waitlist__card">
    <p class="eyebrow">be the first to know</p>
    <h2>Join the list</h2>
    <p class="waitlist__intro">
      Pop your name and email in and I'll send you a note the moment orders open.
      No spam — just cookies.
    </p>

    <form class="waitlist__form" action={action} method="POST" data-formspree>
      <input type="hidden" name="_subject" value="New Even Butter waitlist signup" />
      <input type="hidden" name="_next" value={next} />
      <p class="hp" aria-hidden="true">
        <label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      </p>
      <div class="field">
        <label for="wl-name">Name</label>
        <input id="wl-name" name="name" type="text" autocomplete="name" placeholder="Your name" required />
      </div>
      <div class="field">
        <label for="wl-email">Email</label>
        <input id="wl-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
      </div>
      <button class="btn" type="submit">Notify me</button>
      <p class="waitlist__status" role="status" aria-live="polite" hidden></p>
    </form>
  </div>
</section>

<style>
  .waitlist { background: var(--cream); }
  .waitlist__card {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    background: var(--blush-soft);
    border: 2px solid var(--cocoa);
    border-radius: var(--radius);
    padding: clamp(2rem, 5vw, 3rem);
    box-shadow: var(--shadow-soft);
  }
  .waitlist__intro { max-width: 42ch; margin: 0 auto 1.75rem; color: var(--cocoa-soft); }
  .waitlist__form { display: flex; flex-direction: column; gap: 1rem; text-align: left; }
  .field { display: flex; flex-direction: column; gap: 0.3rem; }
  .field label { font-family: var(--font-display); font-weight: 500; font-size: 0.95rem; }
  .field input {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.75rem 1rem;
    border: 2px solid var(--cocoa);
    border-radius: var(--radius-sm);
    background: var(--white);
    color: var(--cocoa);
  }
  .field input:focus-visible { outline: 3px solid var(--butter); outline-offset: 1px; }
  .waitlist__form .btn { align-self: center; margin-top: 0.5rem; }
  .waitlist__status { text-align: center; font-family: var(--font-display); margin: 0.5rem 0 0; }
  .waitlist__status.is-ok { color: #2f6b3f; }
  .waitlist__status.is-err { color: #9a3b3b; }
  .hp { position: absolute; left: -9999px; height: 0; overflow: hidden; }
</style>

<script>
  const form = document.querySelector("form[data-formspree]");
  if (form) {
    const status = form.querySelector(".waitlist__status");
    const btn = form.querySelector("button");
    const OK_MSG = "You're on the list! Talk soon 🧈";

    const show = (kind, msg) => {
      status.hidden = false;
      status.className = "waitlist__status" + (kind ? ` is-${kind}` : "");
      status.textContent = msg;
    };

    // No-JS submits come back here via Formspree's _next redirect.
    const params = new URLSearchParams(location.search);
    if (params.get("joined") === "1") {
      show("ok", OK_MSG);
      params.delete("joined");
      const clean = location.pathname + (params.size ? `?${params}` : "") + "#waitlist";
      history.replaceState(null, "", clean);
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      data.delete("_next"); // JSON requests never redirect; keep the payload tidy.
      show("", "Sending…");
      btn.disabled = true;
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: data,
          headers: { Accept: "application/json" },
        });
        if (res.ok) {
          form.reset();
          show("ok", OK_MSG);
        } else {
          let detail = "";
          try {
            const body = await res.json();
            if (Array.isArray(body.errors) && body.errors.length) {
              detail = body.errors.map((er) => er.message).join(" ");
            }
          } catch {}
          show("err", detail || "Hmm, something went wrong. Please try again in a moment.");
        }
      } catch (err) {
        show("err", "Couldn't reach the signup service. Check your connection and try again.");
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
