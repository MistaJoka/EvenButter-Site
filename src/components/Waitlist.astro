---
import { WAITLIST_ENDPOINT, SUPABASE_ANON_KEY, isWaitlistConfigured } from "../data/waitlist.js";

if (!isWaitlistConfigured) {
  console.warn(
    "\n[waitlist] PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY are not set. The form" +
      " renders but signups are disabled. See src/data/waitlist.js."
  );
}
---
<section id="waitlist" class="section waitlist">
  <div class="container waitlist__card">
    <p class="eyebrow">be the first to know</p>
    <h2>Join the list</h2>
    <p class="waitlist__intro">
      Pop your name and email in and I'll send you a note the moment orders open.
      No spam — just cookies.
    </p>

    <form
      class="waitlist__form"
      method="POST"
      data-waitlist
      data-endpoint={isWaitlistConfigured ? WAITLIST_ENDPOINT : ""}
      data-key={isWaitlistConfigured ? SUPABASE_ANON_KEY : ""}
    >
      <p class="hp" aria-hidden="true">
        <label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      </p>
      <div class="field">
        <label for="wl-name">Name</label>
        <input id="wl-name" name="name" type="text" autocomplete="name" placeholder="Your name" required />
      </div>
      <div class="field">
        <label for="wl-email">Email</label>
        <input id="wl-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
      </div>
      <button class="btn" type="submit">Notify me</button>
      <p class="waitlist__status" role="status" aria-live="polite" hidden></p>
      <noscript><p class="waitlist__status is-err">Please turn on JavaScript to join the list.</p></noscript>
    </form>
  </div>
</section>

<style>
  .waitlist { background: var(--cream); }
  .waitlist__card {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    background: var(--blush-soft);
    border: 2px solid var(--cocoa);
    border-radius: var(--radius);
    padding: clamp(2rem, 5vw, 3rem);
    box-shadow: var(--shadow-soft);
  }
  .waitlist__intro { max-width: 42ch; margin: 0 auto 1.75rem; color: var(--cocoa-soft); }
  .waitlist__form { display: flex; flex-direction: column; gap: 1rem; text-align: left; }
  .field { display: flex; flex-direction: column; gap: 0.3rem; }
  .field label { font-family: var(--font-display); font-weight: 500; font-size: 0.95rem; }
  .field input {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.75rem 1rem;
    border: 2px solid var(--cocoa);
    border-radius: var(--radius-sm);
    background: var(--white);
    color: var(--cocoa);
  }
  .field input:focus-visible { outline: 3px solid var(--butter); outline-offset: 1px; }
  .waitlist__form .btn { align-self: center; margin-top: 0.5rem; }
  .waitlist__status { text-align: center; font-family: var(--font-display); margin: 0.5rem 0 0; }
  .waitlist__status.is-ok { color: #2f6b3f; }
  .waitlist__status.is-err { color: #9a3b3b; }
  .hp { position: absolute; left: -9999px; height: 0; overflow: hidden; }
</style>

<script>
  const form = document.querySelector("form[data-waitlist]");
  if (form) {
    const status = form.querySelector(".waitlist__status");
    const btn = form.querySelector("button");
    const endpoint = form.dataset.endpoint;
    const key = form.dataset.key;
    const OK_MSG = "You're on the list! Talk soon 🧈";
    const DUPE_MSG = "You're already on the list! Talk soon 🧈";
    const CLOSED_MSG = "Signups aren't open just yet. Check back soon!";
    const ERR_MSG = "Hmm, something went wrong. Please try again in a moment.";
    const NET_MSG = "Couldn't reach the signup service. Check your connection and try again.";

    const show = (kind, msg) => {
      status.hidden = false;
      status.className = "waitlist__status" + (kind ? ` is-${kind}` : "");
      status.textContent = msg;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!endpoint || !key) return show("err", CLOSED_MSG);

      const data = new FormData(form);
      // Bots fill the hidden field. Smile, nod, send nothing.
      if (data.get("_gotcha")) {
        form.reset();
        return show("ok", OK_MSG);
      }
      const payload = {
        name: String(data.get("name") || "").trim(),
        email: String(data.get("email") || "").trim(),
      };

      show("", "Sending…");
      btn.disabled = true;
      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            apikey: key,
            Authorization: `Bearer ${key}`,
            Prefer: "return=minimal",
          },
          body: JSON.stringify(payload),
        });
        if (res.status === 201) {
          form.reset();
          show("ok", OK_MSG);
        } else if (res.status === 409) {
          form.reset();
          show("ok", DUPE_MSG);
        } else {
          show("err", ERR_MSG);
        }
      } catch (err) {
        show("err", NET_MSG);
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
