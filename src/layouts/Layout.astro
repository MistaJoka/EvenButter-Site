---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  noindex = false,
  title = "Even Butter Bake Shop | Small-Batch Cookies in North Miami, FL",
  description = "Homemade small-batch cookies baked in North Miami with premium ingredients, real chocolate, and a lot of butter. Join the list to know when orders open.",
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const ogImage = `${site}/images/og.png`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// TODO(launch): add telephone, sameAs once real.
const bakerySchema = {
  "@context": "https://schema.org",
  "@type": "Bakery",
  "@id": `${site}/#bakery`,
  name: "Even Butter Bake Shop",
  url: `${site}/`,
  logo: `${site}/images/logo.png`,
  image: ogImage,
  description: "Homemade small-batch cookies baked in North Miami with premium ingredients, real chocolate, and a lot of butter.",
  founder: { "@type": "Person", name: "Rachel" },
  address: {
    "@type": "PostalAddress",
    addressLocality: "North Miami",
    addressRegion: "FL",
    addressCountry: "US",
  },
  areaServed: { "@type": "City", name: "North Miami, FL" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FBF4E6" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(bakerySchema)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Even Butter Bake Shop" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Even Butter Bake Shop logo with Marcel the cow in the delivery van" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&family=Fredoka:wght@400;500;600&family=Nunito:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
